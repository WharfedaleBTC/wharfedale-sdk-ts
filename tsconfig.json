{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "outDir": "build",
    "rootDir": ".",
    "paths": {
      "@wharfedale/sdk": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
