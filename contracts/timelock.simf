/*
 * Pay to public key after a block height: the spending transaction must have
 * lock time >= AFTER (a block height) and OWNER's signature.
 *
 * Arguments: { "OWNER": "0x<x-only public key>", "AFTER": "<height>" }
 * Witness:   { "SIG": "sign:<key file>" }
 * Spend with: wharfedale-wallet contract-spend ... --lock-time <height >= AFTER>
 */
fn main() {
    let after: Height = param::AFTER;
    jet::check_lock_height(after);
    jet::bip_0340_verify((param::OWNER, jet::sig_all_hash()), witness::SIG)
}
