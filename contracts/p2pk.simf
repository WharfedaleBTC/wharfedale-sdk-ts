/*
 * Pay to public key: spendable with OWNER's BIP340 signature over the transaction
 * (`sig_all_hash`).
 *
 * Arguments: { "OWNER": "0x<x-only public key>" }   (wharfedale-wallet pubkey --key FILE)
 * Witness:   { "SIG": "sign:<key file>" }            (filled in by wharfedale-wallet)
 */
fn main() {
    jet::bip_0340_verify((param::OWNER, jet::sig_all_hash()), witness::SIG)
}
